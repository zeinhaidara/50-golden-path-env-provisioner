# Managed by the golden path playbook. Rendered per environment.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ golden_path_app_namespace }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ golden_path_app_name }}
  namespace: {{ golden_path_app_namespace }}
  labels:
    app.kubernetes.io/name: {{ golden_path_app_name }}
    environment: {{ golden_path_env }}
spec:
  replicas: {{ golden_path_app_replicas }}
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ golden_path_app_name }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ golden_path_app_name }}
    spec:
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: web
          image: {{ golden_path_app_image }}
          ports:
            - name: http
              containerPort: 8080
          resources:
            requests:
              cpu: 50m
              memory: 32Mi
            limits:
              memory: 64Mi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: [ALL]
          readinessProbe:
            httpGet:
              path: /
              port: http
---
apiVersion: v1
kind: Service
metadata:
  name: {{ golden_path_app_name }}
  namespace: {{ golden_path_app_namespace }}
spec:
  selector:
    app.kubernetes.io/name: {{ golden_path_app_name }}
  ports:
    - name: http
      port: 80
      targetPort: http
