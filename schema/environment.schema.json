{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Golden path environment parameters",
  "type": "object",
  "additionalProperties": false,
  "required": ["environment", "aws", "network", "cluster", "observability", "app"],
  "properties": {
    "environment": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,19}$"},
    "aws": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_id", "region"],
      "properties": {
        "account_id": {"type": "string", "pattern": "^[0-9]{12}$"},
        "region": {"type": "string", "pattern": "^[a-z]{2}-[a-z]+-[0-9]$"}
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vpc_cidr", "availability_zones"],
      "properties": {
        "vpc_cidr": {"type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"},
        "availability_zones": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z]{2}-[a-z]+-[0-9][a-z]$"}
        }
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kubernetes_version", "node_instance_types", "node_min_size", "node_desired_size", "node_max_size", "api_allowed_cidrs"],
      "properties": {
        "kubernetes_version": {"enum": ["1.33", "1.34"]},
        "node_instance_types": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9]+$"}
        },
        "node_min_size": {"type": "integer", "minimum": 1, "maximum": 20},
        "node_desired_size": {"type": "integer", "minimum": 1, "maximum": 20},
        "node_max_size": {"type": "integer", "minimum": 1, "maximum": 20},
        "api_allowed_cidrs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"}
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "retention_days"],
      "properties": {
        "enabled": {"type": "boolean"},
        "retention_days": {"type": "integer", "minimum": 1, "maximum": 30}
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "image", "replicas"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$"},
        "image": {
          "type": "string",
          "description": "Must carry a tag or digest, and not :latest.",
          "pattern": "^[a-z0-9./_-]+(:[A-Za-z0-9._-]+|@sha256:[a-f0-9]{64})$",
          "not": {"pattern": ":latest$"}
        },
        "replicas": {"type": "integer", "minimum": 1, "maximum": 10}
      }
    }
  }
}
