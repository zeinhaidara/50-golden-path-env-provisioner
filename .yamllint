---
extends: default
# Skip what git ignores, e.g. module sources under terraform/.terraform/
ignore-from-file: .gitignore
rules:
  line-length:
    max: 140
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  braces:
    max-spaces-inside: 1
  # Settings ansible-lint expects
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
